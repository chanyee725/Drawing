{
  "name": "drawing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Eraser-like diagramming tool: document + infinite canvas per file",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test",
    "build": "tsc -p shared && tsc -p web && vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@excalidraw/excalidraw": "^0.18.1",
    "@lezer/highlight": "^1.2.5",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-list": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extensions": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@tiptap/suggestion": "^3.33.1",
    "codemirror": "^6.0.2",
    "elkjs": "^0.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
