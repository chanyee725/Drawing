{
  "name": "draw-pipelines",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Eraser-like diagramming tool: document + infinite canvas per file",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test",
    "build": "tsc -p web && vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
